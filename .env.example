# Email Service (Resend)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email Addresses
# FROM: Must be a verified domain in Resend (e.g., contact@goatlabs.dev)
EMAIL_FROM=contact@goatlabs.dev

# TO: Your personal inbox where contact form submissions will be sent
EMAIL_TO=hello@goatlabs.dev

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=hello@goatlabs.dev
NEXT_PUBLIC_CONTACT_PHONE=+48664437489

# Company Details
NEXT_PUBLIC_COMPANY_NAME=GoatLabs
NEXT_PUBLIC_COMPANY_ADDRESS=ul. Przykładowa 42, 00-001 Warszawa, Poland
NEXT_PUBLIC_COMPANY_NIP=000-000-00-00
NEXT_PUBLIC_COMPANY_REGON=000000000

# Social Media
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com
NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com
NEXT_PUBLIC_SOCIAL_TWITTER=https://twitter.com
